<?xml version="1.0"?>
<package format="2">
  <name>simulation_bridges</name>
  <version>0.1.0</version>
  <description>ROS bridges for Gazebo ground truth and simulated Livox point clouds.</description>

  <maintainer email="maintainer@example.com">Fast-Drone Maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>gazebo_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>livox_ros_driver2</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>

  <build_depend>gazebo_dev</build_depend>
  <exec_depend>gazebo_dev</exec_depend>

  <export/>
</package>
