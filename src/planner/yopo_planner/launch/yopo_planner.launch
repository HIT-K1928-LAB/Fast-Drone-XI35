<launch>
  <arg name="config_file" default="$(find yopo_planner)/config/yopo_planner_real.yaml"/>
  <arg name="odom_topic" default="/vins_fusion/imu_propagate"/>
  <arg name="depth_topic" default="/camera/depth/image_rect_raw"/>
  <arg name="ctrl_topic" default="/position_cmd"/>
  <arg name="record_log" default="true"/>
  <arg name="log_dir" default="$(find yopo_planner)/../../../log"/>
  <arg name="bag_prefix" default="yopo_log"/>
  <arg name="local_occupancy_map" default="true"/>
  <arg name="local_map_config" default="$(find local_occupancy_map)/config/local_occupancy_map.yaml"/>
  <arg name="local_map_origin_x" default="-10.0"/>
  <arg name="local_map_origin_y" default="-10.0"/>
  <arg name="local_map_origin_z" default="-0.01"/>
  <arg name="local_map_size_x" default="20.0"/>
  <arg name="local_map_size_y" default="20.0"/>
  <arg name="local_map_size_z" default="4.0"/>

  <node name="yopo_planner_node" pkg="yopo_planner" type="yopo_planner_node" output="screen">
    <rosparam command="load" file="$(arg config_file)" subst_value="true"/>
  </node>

  <node if="$(arg record_log)"
        name="yopo_log_recorder"
        pkg="yopo_planner"
        type="record_yopo_log.py"
        output="screen"
        args="$(arg log_dir) $(arg bag_prefix) /yopo_log/log $(arg odom_topic) $(arg ctrl_topic)"/>

  <include if="$(arg local_occupancy_map)"
           file="$(find local_occupancy_map)/launch/local_occupancy_map.launch">
    <arg name="depth_topic" value="$(arg depth_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="config_file" value="$(arg local_map_config)"/>
    <arg name="map_origin_x" value="$(arg local_map_origin_x)"/>
    <arg name="map_origin_y" value="$(arg local_map_origin_y)"/>
    <arg name="map_origin_z" value="$(arg local_map_origin_z)"/>
    <arg name="map_size_x" value="$(arg local_map_size_x)"/>
    <arg name="map_size_y" value="$(arg local_map_size_y)"/>
    <arg name="map_size_z" value="$(arg local_map_size_z)"/>
  </include>
</launch>
