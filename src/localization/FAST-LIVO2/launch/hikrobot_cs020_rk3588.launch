<launch>
  <!-- MVS is a proprietary ARM64 SDK mounted from the RK3588 host at /opt/MVS. -->
  <arg name="device_serial" default="DA1135025"/>
  <arg name="frame_id" default="hikrobot_camera"/>
  <arg name="image_topic" default="/hikrobot_camera/image_raw"/>
  <!-- Calibrated image geometry: full sensor, no crop, 1x1 binning. -->
  <arg name="width" default="1624"/>
  <arg name="height" default="1240"/>
  <arg name="offset_x" default="0"/>
  <arg name="offset_y" default="0"/>
  <arg name="binning_x" default="1"/>
  <arg name="binning_y" default="1"/>
  <arg name="frame_rate_hz" default="10.0"/>
  <!-- A conservative low-light starting point for the current 10 Hz stream. -->
  <arg name="exposure_time_us" default="20000.0"/>
  <arg name="gain_db" default="6.0"/>
  <!-- Off, Once, Continuous (camera hardware), or Software (node fallback). -->
  <arg name="exposure_auto" default="Off"/>
  <arg name="auto_exposure_target_gray" default="100.0"/>
  <arg name="auto_exposure_min_us" default="1000.0"/>
  <arg name="auto_exposure_max_us" default="90000.0"/>
  <node pkg="fast_livo" type="hikrobot_mvs_node.py" name="hikrobot_mvs_camera" output="screen">
    <env name="MVCAM_SDK_PATH" value="/opt/MVS"/>
    <env name="MVCAM_COMMON_RUNENV" value="/opt/MVS/lib"/>
    <param name="device_serial" value="$(arg device_serial)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="offset_x" value="$(arg offset_x)"/>
    <param name="offset_y" value="$(arg offset_y)"/>
    <param name="binning_x" value="$(arg binning_x)"/>
    <param name="binning_y" value="$(arg binning_y)"/>
    <param name="frame_rate_hz" value="$(arg frame_rate_hz)"/>
    <param name="exposure_time_us" value="$(arg exposure_time_us)"/>
    <param name="gain_db" value="$(arg gain_db)"/>
    <param name="exposure_auto" value="$(arg exposure_auto)"/>
    <param name="auto_exposure_target_gray" value="$(arg auto_exposure_target_gray)"/>
    <param name="auto_exposure_min_us" value="$(arg auto_exposure_min_us)"/>
    <param name="auto_exposure_max_us" value="$(arg auto_exposure_max_us)"/>
  </node>
</launch>
