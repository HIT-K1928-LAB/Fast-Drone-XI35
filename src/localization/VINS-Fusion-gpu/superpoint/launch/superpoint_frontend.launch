<launch>
	<arg name="config_file" default="$(find vins)/../config/fast_drone_250.yaml" />
	<node name="feature_tracker_node" pkg="superpoint"  type="feature_tracker_node" output="log" args="$(arg config_file)">
		<param name="model_path" value="$(find superpoint)/model" type="string"/>
		<param name="lightglue_plugin_path" value="$(find superpoint)/trt_plugins/libcustom_layernorm.so" type="string"/>
		<!-- 0:debug 1:info 2:warn -->
		<param name="print_debug" value="2" type="int"/>
	</node>
</launch>
