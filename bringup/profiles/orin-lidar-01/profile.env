PROFILE_NAME="orin-lidar-01"

# 定位模式：
#   lidar -> FAST-LIVO2 激光惯性视觉里程计
#   mocap -> 动捕定位
LOCALIZATION_DEFAULT="lidar"

# 相机型号，仅用于机型状态展示；具体驱动参数由 config/fastlivo2 管理。
CAMERA_TYPE="realsense_d455"

# 网络
ROS_MASTER_URI_DEFAULT="http://192.168.31.51:11311"
ROS_IP_DEFAULT="192.168.31.51"

#ROS_MASTER_URI_DEFAULT="http://192.168.55.1:11311"
#ROS_IP_DEFAULT="192.168.55.1"

#ROS_MASTER_URI_DEFAULT="http://172.20.10.2:11311"
#ROS_IP_DEFAULT="172.20.10.2"

# ROS_MASTER_URI_DEFAULT="http://192.168.31.20:11311"
# ROS_IP_DEFAULT="192.168.31.51"

# 其他路径环境变量
FAST_DRONE_ROOT="$WORKSPACE"
