PROFILE_NAME="pc_sim"

# 去掉显卡垂直同步，避免Gazebo/RViz渲染卡顿
export __GL_SYNC_TO_VBLANK=0

# 定位来源：
#  ground_truth -> Gazebo模型状态转换为nav_msgs/Odometry
#  vins         -> 双目IMU视觉里程计
#  lidar        -> FAST-LIVO2激光惯性视觉里程计
ODOMETRY_SOURCE="lidar"

# 网络
ROS_MASTER_URI_DEFAULT="http://127.0.0.1:11311"
ROS_IP_DEFAULT="127.0.0.1"

# 其他路径环境变量
FAST_DRONE_ROOT="$WORKSPACE"
PX4_DIR="$FAST_DRONE_ROOT/third_party/px4_sitl"
PX4_BUILD_DIR="$PX4_DIR/build/px4_sitl_default"
SITL_GAZEBO="$PX4_DIR/Tools/sitl_gazebo"
