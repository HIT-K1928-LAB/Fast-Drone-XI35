PROFILE_NAME="pc_sim"

# Disable NVIDIA vertical synchronization for smooth Gazebo/RViz rendering.
export __GL_SYNC_TO_VBLANK=0

# Odometry source used by pc_sim/tmux.sh:
#   ground_truth -> Gazebo model state converted to nav_msgs/Odometry
#   vins         -> stereo VINS-Fusion
#   lidar        -> iris_3d_gpu_lidar stereo + GPU LiDAR + IMU to FAST-LIVO2
ODOMETRY_SOURCE="lidar"

# network
ROS_MASTER_URI_DEFAULT="http://127.0.0.1:11311"
ROS_IP_DEFAULT="127.0.0.1"

FAST_DRONE_ROOT="$WORKSPACE"
PX4_DIR="$FAST_DRONE_ROOT/third_party/px4_sitl"
PX4_BUILD_DIR="$PX4_DIR/build/px4_sitl_default"
SITL_GAZEBO="$PX4_DIR/Tools/sitl_gazebo"
