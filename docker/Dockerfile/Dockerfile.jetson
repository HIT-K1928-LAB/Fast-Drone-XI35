FROM nvcr.io/nvidia/l4t-jetpack:r35.3.1

LABEL maintainer="bkbk_b <1320832053@qq.com>"

USER root

SHELL ["bash", "-e", "-u", "-o", "pipefail", "-c"]

ARG ROS_VERSION=noetic
ARG USE_PROXY=false
ARG BUILD_HTTP_PROXY
ARG BUILD_HTTPS_PROXY
#7.2 for Xavier / 8.7 for Orin
ARG CUDA_ARCH_BIN=8.7
ARG USE_PROC=8
ARG ENABLE_NEON="ON"
ENV OPENCV_VERSION=4.5.4
ARG OPENCV3_VERSION=3.4.16
ARG CERES_VERSION=2.0.0rc1
ARG SOPHUS_REPOSITORY=https://github.com/strasdat/Sophus.git
ARG SOPHUS_COMMIT=a621ff2e56c56c839a6c40418d42c3c254424b5c
ARG VISION_OPENCV_VERSION=1.16.2
ARG LIVOX_SDK2_REPOSITORY=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_COMMIT=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
ARG GLOG_REPOSITORY=https://github.com/boboxxd/glog.git
ARG GLOG_VERSION=master
ENV FDRONE_WS=/root/Fast-Drone-XI35
ARG NO_PROXY="localhost,127.0.0.1,mirrors.tuna.tsinghua.edu.cn,mirrors.ustc.edu.cn"
ENV http_proxy=${BUILD_HTTP_PROXY} \
    https_proxy=${BUILD_HTTPS_PROXY} \
    HTTP_PROXY=${BUILD_HTTP_PROXY} \
    HTTPS_PROXY=${BUILD_HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

# Configure apt sources
RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' /etc/apt/sources.list && \
    sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/80-retries && \
    install -d -m 0755 /etc/apt/keyrings && \
    wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc -O /etc/apt/keyrings/ros.asc && \
    wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://apt.llvm.org/llvm-snapshot.gpg.key -O /etc/apt/keyrings/llvm.asc && \
    wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xFB0B24895113F120" -O /etc/apt/keyrings/librealsense.asc && \
    . /etc/os-release && \
    echo "deb [signed-by=/etc/apt/keyrings/ros.asc] http://mirrors.ustc.edu.cn/ros/ubuntu/ ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/ros-latest.list && \
    echo "deb [signed-by=/etc/apt/keyrings/llvm.asc] https://apt.llvm.org/${VERSION_CODENAME}/ llvm-toolchain-${VERSION_CODENAME}-16 main" > /etc/apt/sources.list.d/llvm-16.list && \
    echo "deb [signed-by=/etc/apt/keyrings/librealsense.asc] https://librealsense.intel.com/Debian/apt-repo ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/librealsense.list

# Install apt packages
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV LC_TIME=C.UTF-8
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    apt-utils \
    tzdata \
    wget \
    curl \
    lsb-release \
    git \
    vim \
    pkg-config \
    openssh-server openssh-client \
    net-tools \
    build-essential \
    autoconf \
    automake \
    libtool \
    htop \
    gdb \
    clangd-16 \
    clang-format-16 \
    zip unzip \
    libdw-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libglib2.0-dev \
    libyaml-cpp-dev \
    liblapack-dev \
    libsuitesparse-dev \
    libcxsparse3 \
    libgflags-dev \
    libgtk2.0-dev \
    tmux \
    ros-${ROS_VERSION}-ros-base \
    ros-${ROS_VERSION}-nav-msgs \
    ros-${ROS_VERSION}-sensor-msgs \
    ros-${ROS_VERSION}-cv-bridge \
    ros-${ROS_VERSION}-rviz \
    ros-${ROS_VERSION}-image-transport-plugins \
    ros-${ROS_VERSION}-pcl-ros \
    ros-${ROS_VERSION}-message-filters \
    ros-${ROS_VERSION}-dynamic-reconfigure \
    ros-${ROS_VERSION}-rqt-reconfigure \
    ros-${ROS_VERSION}-tf \
    ros-${ROS_VERSION}-catkin \
    python3-catkin-tools \
    ros-${ROS_VERSION}-roslint \
    ros-${ROS_VERSION}-ddynamic-reconfigure \
    ros-${ROS_VERSION}-vrpn \
    ros-${ROS_VERSION}-geometry-msgs \
    ros-${ROS_VERSION}-tf2-ros \
    ros-${ROS_VERSION}-roscpp \
    ros-${ROS_VERSION}-roslaunch \
    ros-${ROS_VERSION}-cmake-modules \
    ros-${ROS_VERSION}-eigen-conversions \
    ros-${ROS_VERSION}-visualization-msgs \
    ros-${ROS_VERSION}-vrpn-client-ros \
    ros-${ROS_VERSION}-mavros \
    librealsense2-dev=2.55.1-0~realsense.3336 \
    librealsense2=2.55.1-0~realsense.3336 \
    librealsense2-utils=2.55.1-0~realsense.3336 \
    librealsense2-dbg=2.55.1-0~realsense.3336 \
    librealsense2-gl=2.55.1-0~realsense.3336 \
    python3-pip \
    gstreamer1.0-tools \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    ros-${ROS_VERSION}-camera-calibration-parsers \
    ros-${ROS_VERSION}-camera-info-manager && \
    update-alternatives --install /usr/bin/clangd clangd /usr/bin/clangd-16 160 && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-16 160 && \
    update-alternatives --set clangd /usr/bin/clangd-16 && \
    update-alternatives --set clang-format /usr/bin/clang-format-16 && \
    apt-mark hold librealsense2 librealsense2-dev librealsense2-utils librealsense2-dbg && \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    echo "source /opt/ros/${ROS_VERSION}/setup.bash" >> /root/.bashrc && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Livox ROS Driver2 links this SDK from /usr/local/lib. The driver source is
# mounted with the project at runtime, while the SDK is part of the image.
RUN   for attempt in 1 2 3 4 5; do \
          git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
              ${LIVOX_SDK2_REPOSITORY} /tmp/Livox-SDK2 && break; \
          rm -rf /tmp/Livox-SDK2; \
          sleep 5; \
      done && \
      test -d /tmp/Livox-SDK2/.git && \
      git -C /tmp/Livox-SDK2 checkout --detach ${LIVOX_SDK2_COMMIT} && \
      cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
          -DCMAKE_BUILD_TYPE=Release && \
      cmake --build /tmp/Livox-SDK2/build --parallel ${USE_PROC} && \
      cmake --install /tmp/Livox-SDK2/build && \
      ldconfig && \
      rm -rf /tmp/Livox-SDK2

# FAST-LIVO2 requires the legacy, non-templated Sophus API. The two setter
# substitutions make that pinned revision compatible with Eigen on Ubuntu 20.04.
RUN   for attempt in 1 2 3 4 5; do \
          git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
              ${SOPHUS_REPOSITORY} /tmp/Sophus && break; \
          rm -rf /tmp/Sophus; \
          sleep 5; \
      done && \
      test -d /tmp/Sophus/.git && \
      git -C /tmp/Sophus checkout --detach ${SOPHUS_COMMIT} && \
      sed -i \
          -e 's/unit_complex_\.real() = 1\.;/unit_complex_.real(1.);/' \
          -e 's/unit_complex_\.imag() = 0\.;/unit_complex_.imag(0.);/' \
          /tmp/Sophus/sophus/so2.cpp && \
      cmake -S /tmp/Sophus -B /tmp/Sophus/build \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr/local && \
      cmake --build /tmp/Sophus/build --target Sophus --parallel ${USE_PROC} && \
      cmake --install /tmp/Sophus/build && \
      install -d /usr/local/lib/cmake/Sophus && \
      printf '%s\n' \
          'set(Sophus_INCLUDE_DIR "/usr/local/include;/usr/include/eigen3")' \
          'set(Sophus_INCLUDE_DIRS "/usr/local/include;/usr/include/eigen3")' \
          'set(Sophus_LIBRARIES "/usr/local/lib/libSophus.so")' \
          'set(Sophus_LIBRARY "/usr/local/lib/libSophus.so")' \
          'set(Sophus_LIBRARY_DIR "/usr/local/lib")' \
          'set(Sophus_LIBRARY_DIRS "/usr/local/lib")' \
          > /usr/local/lib/cmake/Sophus/SophusConfig.cmake && \
      ldconfig && \
      rm -rf /tmp/Sophus /root/.cmake/packages/Sophus

# Prepare cv_bridge from vision_opencv for OpenCV 4
RUN   wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://github.com/ros-perception/vision_opencv/archive/refs/tags/${VISION_OPENCV_VERSION}.zip -O /tmp/vision_opencv.zip && \
      unzip -q /tmp/vision_opencv.zip -d /root && \
      mv /root/vision_opencv-${VISION_OPENCV_VERSION}/cv_bridge /root/cv_bridge${OPENCV_VERSION} && \
      rm -rf /root/vision_opencv-${VISION_OPENCV_VERSION} /tmp/vision_opencv.zip && \
      sed -i 's|^project(cv_bridge)$|#project(cv_bridge)\nproject(cv_bridge_454)|' /root/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
      sed -i '/^set(_opencv_version 4)/i set(OpenCV_DIR /usr/local/opencv-4.5.4/lib/cmake/opencv4)#use self-opencv' /root/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
      sed -i '/^  set(_opencv_version 3)$/a else()\n  message(WARNING "CV_Bridge use OpenCV_VERSION: ${OpenCV_VERSION}")\n  message(WARNING "OpenCV Path is: ${OpenCV_INSTALL_PATH}")' /root/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
      sed -i 's|<name>cv_bridge</name>|<name>cv_bridge_454</name>|' /root/cv_bridge${OPENCV_VERSION}/package.xml

#Install OpenCV4 with CUDA
RUN   mkdir -p /tmp/opencv-build/boostdesc_extfiles && \
      cd /tmp/opencv-build && \
      for file in boostdesc_bgm.i boostdesc_bgm_bi.i boostdesc_bgm_hd.i \
                  boostdesc_binboost_064.i boostdesc_binboost_128.i boostdesc_binboost_256.i \
                  boostdesc_lbgm.i; do \
          wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_boostdesc_20161012/${file} \
               -O boostdesc_extfiles/${file}; \
      done && \
      for file in vgg_generated_48.i vgg_generated_64.i vgg_generated_80.i vgg_generated_120.i; do \
          wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_vgg_20160317/${file} \
               -O boostdesc_extfiles/${file}; \
      done && \
      for attempt in 1 2 3 4 5; do \
          git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv_contrib.git opencv_contrib && break; \
          rm -rf opencv_contrib; \
          sleep 5; \
      done && \
      test -d opencv_contrib && \
      cp boostdesc_extfiles/*.i opencv_contrib/modules/xfeatures2d/src/ && \
      wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://github.com/opencv/opencv/archive/${OPENCV_VERSION}.zip -O opencv.zip && \
      unzip -q opencv.zip && \
      rm opencv.zip && \
      cd opencv-${OPENCV_VERSION} && \
      mkdir build && cd build && \
      cmake .. \
            -D CMAKE_BUILD_TYPE=RELEASE \
            -D CMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV_VERSION} \
            -D WITH_CUDA=ON \
            -D WITH_CUDNN=ON \
            -D WITH_CUBLAS=ON \
            -D CUDNN_VERSION='8.6' \
            -D CUDNN_INCLUDE_DIR=/usr/include/ \
            -D CUDA_ARCH_BIN=${CUDA_ARCH_BIN} \
            -D CUDA_ARCH_PTX="" \
            -D CUDA_FAST_MATH=ON \
            -D WITH_TBB=ON \
            -D BUILD_opencv_python2=OFF \
            -D BUILD_opencv_python3=ON \
            -D OPENCV_DNN_CUDA=ON \
            -D OPENCV_ENABLE_NONFREE=ON \
            -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
            -D BUILD_EXAMPLES=OFF \
            -D BUILD_opencv_java=OFF \
            -D BUILD_opencv_python=OFF \
            -D BUILD_TESTS=OFF \
            -D BUILD_PERF_TESTS=OFF \
            -D BUILD_opencv_apps=OFF \
            -D ENABLE_NEON=${ENABLE_NEON} \
            -D EIGEN_INCLUDE_PATH=/usr/include/eigen3 \
            -D WITH_EIGEN=ON \
            -D WITH_IPP=OFF \
            -D WITH_OPENCL=OFF \
            -D PYTHON3_LIBRARY=/usr/lib/aarch64-linux-gnu/libpython3.8.so \
            -D BUILD_LIST="calib3d,features2d,highgui,dnn,imgproc,imgcodecs,photo,cudev,cudaoptflow,cudaimgproc,cudalegacy,cudaarithm,cudacodec,cudastereo,cudafeatures2d,xfeatures2d,tracking,stereo,aruco,videoio,ccalib" && \
      make -j${USE_PROC} && \
      make install && \
      rm -rf /tmp/opencv-build /var/lib/apt/lists/* /var/cache/apt/*

#Build cv_bridge for opencv4.5.4
RUN   mkdir -p /root/cv_bridge${OPENCV_VERSION}_ws/src && \
      mv /root/cv_bridge${OPENCV_VERSION} /root/cv_bridge${OPENCV_VERSION}_ws/src && \
      /bin/bash -c 'source /opt/ros/${ROS_VERSION}/setup.bash && \
      cd /root/cv_bridge${OPENCV_VERSION}_ws && catkin_make && echo "source /root/cv_bridge${OPENCV_VERSION}_ws/devel/setup.bash" >> /root/.bashrc'

# Install MAVROS GeographicLib datasets
RUN   cd /opt/ros/${ROS_VERSION}/lib/mavros && \
      for attempt in 1 2 3 4 5; do \
          ./install_geographiclib_datasets.sh && break; \
          sleep 5; \
      done && \
      test -d /usr/share/GeographicLib

# Build glog
RUN   for attempt in 1 2 3 4 5; do \
          git clone --depth 1 --branch ${GLOG_VERSION} ${GLOG_REPOSITORY} /tmp/glog && break; \
          rm -rf /tmp/glog; \
          sleep 5; \
      done && \
      test -d /tmp/glog && \
      cd /tmp/glog && \
      chmod +x autogen.sh && \
      ./autogen.sh && \
      ./configure && \
      make -j${USE_PROC} && \
      make install && \
      ldconfig && \
      rm -rf /tmp/glog

#Build ceres
RUN   wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://github.com/ceres-solver/ceres-solver/archive/refs/tags/${CERES_VERSION}.zip -O /tmp/ceres-solver.zip && \
      unzip -q /tmp/ceres-solver.zip -d /tmp && \
      cd /tmp/ceres-solver-${CERES_VERSION} && mkdir build && cd build && \
      cmake -DCMAKE_BUILD_TYPE=Release \
            -DCUDA=OFF \
            -DBUILD_TESTING=OFF \
            -DBUILD_EXAMPLES=OFF \
            -DBUILD_BENCHMARKS=OFF \
            .. && \
      make -j${USE_PROC} && \
      make install && \
      rm -rf /tmp/ceres-solver.zip /tmp/ceres-solver-${CERES_VERSION}

#Install LCM
RUN   for attempt in 1 2 3 4 5; do \
          git clone --depth 1 --branch v1.4.0 https://github.com/lcm-proj/lcm /tmp/lcm && break; \
          rm -rf /tmp/lcm; \
          sleep 5; \
      done && \
      test -d /tmp/lcm && \
      cd /tmp/lcm && \
      mkdir build && cd build && \
      cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARKS=OFF .. && \
      make -j${USE_PROC} && make install && \
      rm -rf /tmp/lcm
#Install onnxruntime
RUN   /usr/bin/pip3 install --retries 5 --timeout 60 --no-cache-dir onnxruntime -i https://pypi.tuna.tsinghua.edu.cn/simple
#Build OpenCV3.4.16
RUN   cd /tmp && \
      wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://github.com/opencv/opencv/archive/refs/tags/${OPENCV3_VERSION}.zip -O opencv-${OPENCV3_VERSION}.zip && \
      wget -q --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused https://github.com/opencv/opencv_contrib/archive/refs/tags/${OPENCV3_VERSION}.zip -O opencv_contrib-${OPENCV3_VERSION}.zip && \
      unzip -q opencv-${OPENCV3_VERSION}.zip && \
      unzip -q opencv_contrib-${OPENCV3_VERSION}.zip && \
      rm opencv-${OPENCV3_VERSION}.zip opencv_contrib-${OPENCV3_VERSION}.zip && \
      cd /tmp/opencv-${OPENCV3_VERSION} && mkdir build && cd build && \
      cmake -D CMAKE_BUILD_TYPE=RELEASE \
      -D CMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV3_VERSION} \
      -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib-${OPENCV3_VERSION}/modules \
      -D WITH_CUDA=ON \
      -D CUDA_ARCH_BIN=${CUDA_ARCH_BIN} \
      -D CUDNN_VERSION='8.6' \
      -D CUDNN_INCLUDE_DIR=/usr/include/ \
      -D CUDA_ARCH_PTX="" \
      -D ENABLE_FAST_MATH=ON \
      -D CUDA_FAST_MATH=ON \
      -D WITH_CUBLAS=ON \
      -D WITH_LIBV4L=ON \
      -D WITH_GSTREAMER=ON \
      -D WITH_GSTREAMER_0_10=OFF \
      -D WITH_QT=ON \
      -D WITH_OPENGL=ON \
      -D CUDA_NVCC_FLAGS="--expt-relaxed-constexpr" \
      -D WITH_TBB=ON \
      -D BUILD_opencv_python=OFF \
      -D BUILD_opencv_python2=OFF \
      -D BUILD_opencv_python3=OFF \
      -D BUILD_opencv_java=OFF \
      -D BUILD_TESTS=OFF \
      -D BUILD_PERF_TESTS=OFF \
      -D BUILD_EXAMPLES=OFF \
      .. && \
      make -j${USE_PROC} && \
      make install && \
      rm -rf /tmp/opencv-${OPENCV3_VERSION} /tmp/opencv_contrib-${OPENCV3_VERSION}
#Other config
RUN   /usr/bin/pip3 install --retries 5 --timeout 60 --no-cache-dir scikit-image

#Config SSH
RUN  mkdir /var/run/sshd && \
echo 'root:123456' | chpasswd && \
sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

EXPOSE 22

# Clean up all temp files
RUN apt-get clean && rm -rf /tmp/* /var/tmp/* /var/lib/apt/lists/* /var/cache/apt/*
ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

WORKDIR ${FDRONE_WS}

# container init
COPY ./container_init.sh /
RUN mkdir -p /daemon && chmod +x /container_init.sh
ENTRYPOINT ["/bin/bash", "/container_init.sh"]
CMD ["/bin/bash"]
