FROM ros:noetic-ros-base-focal

LABEL org.opencontainers.image.authors="zhangrun <1139135655@qq.com>"
LABEL org.opencontainers.image.description="ROS Noetic + RKNN runtime for RK3588 on an openEuler host"

SHELL ["bash", "-e", "-u", "-o", "pipefail", "-c"]

USER root

ARG ROS_VERSION=noetic
ARG USE_PROC=8
ARG USE_PROXY=false
ARG BUILD_HTTP_PROXY
ARG BUILD_HTTPS_PROXY
ARG NO_PROXY="localhost,127.0.0.1,mirrors.tuna.tsinghua.edu.cn,mirrors.ustc.edu.cn,snapshots.ros.org"
ARG OPENCV_VERSION=4.5.4
ARG OPENCV3_VERSION=3.4.16
ARG CERES_VERSION=2.0.0rc1
ARG LIBREALSENSE_VERSION=2.55.1
ARG VISION_OPENCV_VERSION=1.16.2
ARG SOPHUS_REPOSITORY=https://github.com/strasdat/Sophus.git
ARG SOPHUS_COMMIT=a621ff2e56c56c839a6c40418d42c3c254424b5c
ARG RKNN_TOOLKIT_VERSION=2.3.2
ARG RKNN_TOOLKIT_REPOSITORY=https://github.com/airockchip/rknn-toolkit2.git
ARG LIVOX_SDK2_REPOSITORY=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_COMMIT=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
ARG WGET_RETRY_OPTS="--quiet --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused"
ARG PIP_RETRY_OPTS="--retries 5 --timeout 60 --no-cache-dir"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LC_TIME=C.UTF-8 \
    FDRONE_WS=/root/Fast-Drone-XI35 \
    OPENCV_VERSION=${OPENCV_VERSION} \
    RKNN_TARGET_SOC=RK3588 \
    http_proxy=${BUILD_HTTP_PROXY} \
    https_proxy=${BUILD_HTTPS_PROXY} \
    HTTP_PROXY=${BUILD_HTTP_PROXY} \
    HTTPS_PROXY=${BUILD_HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

# Keep the Ubuntu/ROS userspace used by the existing project. openEuler remains
# the host OS and provides the kernel, Docker, and the RK3588 device drivers.
RUN sed -i \
        -e 's|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' \
        -e 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        /etc/apt/sources.list && \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
        > /etc/apt/apt.conf.d/80-retries

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-utils \
        aravis-tools \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        clang-format \
        clangd \
        cmake \
        curl \
        gdb \
        git \
        git-lfs \
        gstreamer1.0-tools \
        htop \
        iproute2 \
        libatlas-base-dev \
        libavcodec-dev \
        libavformat-dev \
        libcxsparse3 \
        libdw-dev \
        libeigen3-dev \
        libgflags-dev \
        libglib2.0-dev \
        libgoogle-glog-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer-plugins-good1.0-dev \
        libgtk2.0-dev \
        libgtk-3-dev \
        libjpeg-dev \
        liblapack-dev \
        libpng-dev \
        libssl-dev \
        libsuitesparse-dev \
        libswscale-dev \
        libtbb-dev \
        libtiff-dev \
        libtool \
        libudev-dev \
        libusb-1.0-0-dev \
        libv4l-dev \
        libyaml-cpp-dev \
        net-tools \
        openssh-client \
        openssh-server \
        pkg-config \
        python3-catkin-tools \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        tmux \
        tzdata \
        unzip \
        vim \
        wget \
        zip \
        ros-${ROS_VERSION}-camera-calibration-parsers \
        ros-${ROS_VERSION}-camera-info-manager \
        ros-${ROS_VERSION}-catkin \
        ros-${ROS_VERSION}-cmake-modules \
        ros-${ROS_VERSION}-cv-bridge \
        ros-${ROS_VERSION}-ddynamic-reconfigure \
        ros-${ROS_VERSION}-eigen-conversions \
        ros-${ROS_VERSION}-geometry-msgs \
        ros-${ROS_VERSION}-image-transport-plugins \
        ros-${ROS_VERSION}-mavros \
        ros-${ROS_VERSION}-message-filters \
        ros-${ROS_VERSION}-nav-msgs \
        ros-${ROS_VERSION}-pcl-ros \
        ros-${ROS_VERSION}-roslint \
        ros-${ROS_VERSION}-rviz \
        ros-${ROS_VERSION}-sensor-msgs \
        ros-${ROS_VERSION}-tf \
        ros-${ROS_VERSION}-tf2-ros \
        ros-${ROS_VERSION}-visualization-msgs \
        ros-${ROS_VERSION}-vrpn \
        ros-${ROS_VERSION}-vrpn-client-ros && \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    echo "source /opt/ros/${ROS_VERSION}/setup.bash" >> /root/.bashrc

# Livox ROS Driver2 links this SDK from /usr/local/lib.  The driver source is
# mounted with the project at runtime, while the SDK is part of the image.
RUN for attempt in 1 2 3 4 5; do \
        git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
            ${LIVOX_SDK2_REPOSITORY} /tmp/Livox-SDK2 && break; \
        rm -rf /tmp/Livox-SDK2; \
        sleep 5; \
    done && \
    test -d /tmp/Livox-SDK2/.git && \
    git -C /tmp/Livox-SDK2 checkout --detach ${LIVOX_SDK2_COMMIT} && \
    cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
        -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/Livox-SDK2/build --parallel ${USE_PROC} && \
    cmake --install /tmp/Livox-SDK2/build && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# FAST-LIVO2 uses this pinned legacy Sophus API.
RUN for attempt in 1 2 3 4 5; do \
        git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
            ${SOPHUS_REPOSITORY} /tmp/Sophus && break; \
        rm -rf /tmp/Sophus; \
        sleep 5; \
    done && \
    test -d /tmp/Sophus/.git && \
    git -C /tmp/Sophus checkout --detach ${SOPHUS_COMMIT} && \
    sed -i \
        -e 's/unit_complex_\.real() = 1\.;/unit_complex_.real(1.);/' \
        -e 's/unit_complex_\.imag() = 0\.;/unit_complex_.imag(0.);/' \
        /tmp/Sophus/sophus/so2.cpp && \
    cmake -S /tmp/Sophus -B /tmp/Sophus/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/Sophus/build --target Sophus --parallel ${USE_PROC} && \
    cmake --install /tmp/Sophus/build && \
    install -d /usr/local/lib/cmake/Sophus && \
    printf '%s\n' \
        'set(Sophus_INCLUDE_DIR "/usr/local/include;/usr/include/eigen3")' \
        'set(Sophus_INCLUDE_DIRS "/usr/local/include;/usr/include/eigen3")' \
        'set(Sophus_LIBRARIES "/usr/local/lib/libSophus.so")' \
        'set(Sophus_LIBRARY "/usr/local/lib/libSophus.so")' \
        'set(Sophus_LIBRARY_DIR "/usr/local/lib")' \
        'set(Sophus_LIBRARY_DIRS "/usr/local/lib")' \
        > /usr/local/lib/cmake/Sophus/SophusConfig.cmake && \
    ldconfig && \
    rm -rf /tmp/Sophus /root/.cmake/packages/Sophus

# Download files needed by OpenCV contrib and the custom cv_bridge package.
RUN mkdir -p /tmp/opencv-build/boostdesc_extfiles && \
    for file in boostdesc_bgm.i boostdesc_bgm_bi.i boostdesc_bgm_hd.i \
                boostdesc_binboost_064.i boostdesc_binboost_128.i boostdesc_binboost_256.i \
                boostdesc_lbgm.i; do \
        wget ${WGET_RETRY_OPTS} --inet4-only \
            https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_boostdesc_20161012/${file} \
            -O /tmp/opencv-build/boostdesc_extfiles/${file}; \
    done && \
    for file in vgg_generated_48.i vgg_generated_64.i vgg_generated_80.i vgg_generated_120.i; do \
        wget ${WGET_RETRY_OPTS} --inet4-only \
            https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_vgg_20160317/${file} \
            -O /tmp/opencv-build/boostdesc_extfiles/${file}; \
    done && \
    git clone --depth 1 --branch ${OPENCV_VERSION} \
        https://github.com/opencv/opencv_contrib.git /tmp/opencv-build/opencv_contrib && \
    cp /tmp/opencv-build/boostdesc_extfiles/*.i \
        /tmp/opencv-build/opencv_contrib/modules/xfeatures2d/src/ && \
    wget ${WGET_RETRY_OPTS} --inet4-only \
        https://github.com/opencv/opencv/archive/${OPENCV_VERSION}.zip \
        -O /tmp/opencv-build/opencv.zip && \
    unzip -q /tmp/opencv-build/opencv.zip -d /tmp/opencv-build

# RK3588 has no CUDA. OpenCV uses CPU/NEON; inference acceleration is provided
# separately through RKNN/RKNPU2.
RUN cmake \
        -S /tmp/opencv-build/opencv-${OPENCV_VERSION} \
        -B /tmp/opencv-build/opencv-${OPENCV_VERSION}/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV_VERSION} \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv-build/opencv_contrib/modules \
        -DBUILD_LIST=calib3d,features2d,highgui,dnn,imgproc,imgcodecs,photo,xfeatures2d,tracking,stereo,aruco,videoio,ccalib \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_JAVA=OFF \
        -DBUILD_opencv_apps=OFF \
        -DBUILD_opencv_python2=OFF \
        -DBUILD_opencv_python3=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_TESTS=OFF \
        -DENABLE_NEON=ON \
        -DOPENCV_ENABLE_NONFREE=ON \
        -DWITH_CUDA=OFF \
        -DWITH_EIGEN=ON \
        -DWITH_GSTREAMER=ON \
        -DWITH_IPP=OFF \
        -DWITH_OPENCL=OFF \
        -DWITH_TBB=ON && \
    cmake --build /tmp/opencv-build/opencv-${OPENCV_VERSION}/build --parallel ${USE_PROC} && \
    cmake --install /tmp/opencv-build/opencv-${OPENCV_VERSION}/build && \
    printf '/usr/local/opencv-%s/lib\n' "${OPENCV_VERSION}" \
        > /etc/ld.so.conf.d/opencv-${OPENCV_VERSION}.conf && \
    ldconfig

RUN for attempt in 1 2 3 4 5; do \
        git -c http.version=HTTP/1.1 clone --depth 1 --branch ${VISION_OPENCV_VERSION} \
            https://github.com/ros-perception/vision_opencv.git \
            /tmp/vision_opencv-${VISION_OPENCV_VERSION} && break; \
        rm -rf /tmp/vision_opencv-${VISION_OPENCV_VERSION}; \
        sleep 5; \
    done && \
    test -d /tmp/vision_opencv-${VISION_OPENCV_VERSION}/.git && \
    mkdir -p /root/cv_bridge${OPENCV_VERSION}_ws/src && \
    mv /tmp/vision_opencv-${VISION_OPENCV_VERSION}/cv_bridge \
        /root/cv_bridge${OPENCV_VERSION}_ws/src/cv_bridge${OPENCV_VERSION} && \
    sed -i 's|^project(cv_bridge)$|project(cv_bridge_454)|' \
        /root/cv_bridge${OPENCV_VERSION}_ws/src/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
    sed -i '/^set(_opencv_version 4)/i set(OpenCV_DIR /usr/local/opencv-4.5.4/lib/cmake/opencv4)' \
        /root/cv_bridge${OPENCV_VERSION}_ws/src/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
    sed -i 's|<name>cv_bridge</name>|<name>cv_bridge_454</name>|' \
        /root/cv_bridge${OPENCV_VERSION}_ws/src/cv_bridge${OPENCV_VERSION}/package.xml && \
    set +u && \
    source /opt/ros/${ROS_VERSION}/setup.bash && \
    set -u && \
    cd /root/cv_bridge${OPENCV_VERSION}_ws && \
    catkin_make -j${USE_PROC} && \
    echo "source /root/cv_bridge${OPENCV_VERSION}_ws/devel/setup.bash" >> /root/.bashrc

# Build librealsense with the userspace USB backend. This avoids relying on an
# Ubuntu DKMS package while the host kernel is openEuler/Rockchip.
RUN wget ${WGET_RETRY_OPTS} --inet4-only \
        https://github.com/IntelRealSense/librealsense/archive/refs/tags/v${LIBREALSENSE_VERSION}.zip \
        -O /tmp/librealsense.zip && \
    unzip -q /tmp/librealsense.zip -d /tmp && \
    cmake \
        -S /tmp/librealsense-${LIBREALSENSE_VERSION} \
        -B /tmp/librealsense-${LIBREALSENSE_VERSION}/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_GRAPHICAL_EXAMPLES=OFF \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_WITH_CUDA=OFF \
        -DBUILD_WITH_TM2=OFF \
        -DFORCE_RSUSB_BACKEND=ON && \
    cmake --build /tmp/librealsense-${LIBREALSENSE_VERSION}/build --parallel ${USE_PROC} && \
    cmake --install /tmp/librealsense-${LIBREALSENSE_VERSION}/build && \
    ldconfig

RUN wget ${WGET_RETRY_OPTS} --inet4-only \
        https://github.com/ceres-solver/ceres-solver/archive/refs/tags/${CERES_VERSION}.zip \
        -O /tmp/ceres.zip && \
    unzip -q /tmp/ceres.zip -d /tmp && \
    cmake \
        -S /tmp/ceres-solver-${CERES_VERSION} \
        -B /tmp/ceres-solver-${CERES_VERSION}/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF \
        -DCUDA=OFF && \
    cmake --build /tmp/ceres-solver-${CERES_VERSION}/build --parallel ${USE_PROC} && \
    cmake --install /tmp/ceres-solver-${CERES_VERSION}/build

RUN git clone --depth 1 --branch v1.4.0 https://github.com/lcm-proj/lcm /tmp/lcm && \
    cmake \
        -S /tmp/lcm \
        -B /tmp/lcm/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF && \
    cmake --build /tmp/lcm/build --parallel ${USE_PROC} && \
    cmake --install /tmp/lcm/build && \
    ldconfig

# RKNN Toolkit Lite2 provides Python deployment APIs. Install the matching C
# runtime and headers as well so ROS C++ nodes can link against librknnrt.
RUN GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 --branch v${RKNN_TOOLKIT_VERSION} \
        ${RKNN_TOOLKIT_REPOSITORY} /tmp/rknn-toolkit2 && \
    git -C /tmp/rknn-toolkit2 lfs pull \
        --include='rknpu2/runtime/Linux/librknn_api/**,rknn-toolkit-lite2/packages/*cp38*aarch64.whl' && \
    install -m 0755 \
        /tmp/rknn-toolkit2/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so \
        /usr/local/lib/librknnrt.so && \
    install -m 0644 \
        /tmp/rknn-toolkit2/rknpu2/runtime/Linux/librknn_api/include/*.h \
        /usr/local/include/ && \
    ln -sfn /usr/local/lib/librknnrt.so /usr/local/lib/librknn_api.so && \
    /usr/bin/pip3 install ${PIP_RETRY_OPTS} 'numpy<2' && \
    /usr/bin/pip3 install ${PIP_RETRY_OPTS} \
        /tmp/rknn-toolkit2/rknn-toolkit-lite2/packages/*cp38*aarch64.whl && \
    ldconfig

# The legacy recognition packages explicitly point at OpenCV 3.4.16. Keep a
# CPU/NEON build at the same path as the PC and Jetson images.
RUN wget ${WGET_RETRY_OPTS} --inet4-only \
        https://github.com/opencv/opencv/archive/refs/tags/${OPENCV3_VERSION}.zip \
        -O /tmp/opencv3.zip && \
    wget ${WGET_RETRY_OPTS} --inet4-only \
        https://github.com/opencv/opencv_contrib/archive/refs/tags/${OPENCV3_VERSION}.zip \
        -O /tmp/opencv3-contrib.zip && \
    unzip -q /tmp/opencv3.zip -d /tmp && \
    unzip -q /tmp/opencv3-contrib.zip -d /tmp && \
    cmake \
        -S /tmp/opencv-${OPENCV3_VERSION} \
        -B /tmp/opencv-${OPENCV3_VERSION}/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV3_VERSION} \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib-${OPENCV3_VERSION}/modules \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_JAVA=OFF \
        -DBUILD_opencv_python2=OFF \
        -DBUILD_opencv_python3=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_TESTS=OFF \
        -DENABLE_NEON=ON \
        -DWITH_CUDA=OFF \
        -DWITH_GSTREAMER=ON \
        -DWITH_OPENCL=OFF \
        -DWITH_QT=OFF \
        -DWITH_TBB=ON && \
    cmake --build /tmp/opencv-${OPENCV3_VERSION}/build --parallel ${USE_PROC} && \
    cmake --install /tmp/opencv-${OPENCV3_VERSION}/build

RUN cd /opt/ros/${ROS_VERSION}/lib/mavros && \
    for attempt in 1 2 3 4 5; do \
        ./install_geographiclib_datasets.sh && \
            test -r /usr/share/GeographicLib/geoids/egm96-5.pgm && break; \
        sleep 5; \
    done && \
    test -r /usr/share/GeographicLib/geoids/egm96-5.pgm

RUN /usr/bin/pip3 install ${PIP_RETRY_OPTS} \
        'numpy>=1.21.6,<2' \
        'onnxruntime==1.16.3' \
        'scikit-image==0.21.0' \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

RUN mkdir -p /var/run/sshd /daemon && \
    apt-get clean && \
    rm -rf /tmp/* /var/tmp/* /var/lib/apt/lists/* /var/cache/apt/*

ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

WORKDIR ${FDRONE_WS}

COPY ./container_init.sh /
RUN chmod +x /container_init.sh

ENTRYPOINT ["/bin/bash", "/container_init.sh"]
CMD ["/bin/bash"]
