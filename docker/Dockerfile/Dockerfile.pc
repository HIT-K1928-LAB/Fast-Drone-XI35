FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

LABEL org.opencontainers.image.authors="zhangrun <1139135655@qq.com>"
LABEL org.opencontainers.image.description="ROS Noetic + CUDA + CUDNN + TensorRT environment"

SHELL ["bash", "-c"]

# modify CUDA_ARCH_BIN according to your GPU architecture
ARG CUDA_ARCH_BIN=8.9

USER root
ARG USE_PROXY=false
ARG BUILD_HTTP_PROXY
ARG BUILD_HTTPS_PROXY
ARG ROS_VERSION=noetic
ARG USE_PROC=8
ARG ENABLE_NEON="OFF"
ENV OPENCV_VERSION=4.5.4
ARG OPENCV3_VERSION=3.4.16
ARG CERES_VERSION=2.0.0rc1
ARG SOPHUS_REPOSITORY=https://github.com/strasdat/Sophus.git
ARG SOPHUS_COMMIT=a621ff2e56c56c839a6c40418d42c3c254424b5c
ARG VISION_OPENCV_VERSION=1.16.2
ARG LIVOX_SDK2_REPOSITORY=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_COMMIT=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
ARG WGET_RETRY_OPTS="--quiet --tries=5 --waitretry=5 --timeout=30 --read-timeout=30 --retry-connrefused"
ARG PIP_RETRY_OPTS="--retries 5 --timeout 60 --no-cache-dir"
ENV FDRONE_WS=/root/Fast-Drone-XI35
ARG NO_PROXY="localhost,127.0.0.1,mirrors.tuna.tsinghua.edu.cn,mirrors.ustc.edu.cn"
ENV http_proxy=${BUILD_HTTP_PROXY} \
    https_proxy=${BUILD_HTTPS_PROXY} \
    HTTP_PROXY=${BUILD_HTTP_PROXY} \
    HTTPS_PROXY=${BUILD_HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    NO_PROXY=${NO_PROXY}

# Use Tsinghua University source mirror
RUN printf "%s\n" \
    "deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ focal main restricted universe multiverse" \
    "deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ focal-updates main restricted universe multiverse" \
    "deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ focal-backports main restricted universe multiverse" \
    "deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ focal-security main restricted universe multiverse" \
    > /etc/apt/sources.list && \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/80-retries

# Base build and runtime dependencies
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    wget \
    curl \
    lsb-release \
    git \
    vim \
    pkg-config \
    openssh-server \
    openssh-client \
    net-tools \
    build-essential \
    htop \
    gdb \
    zip \
    unzip \
    libdw-dev \
    libatlas-base-dev \
    libeigen3-dev \
    libglib2.0-dev \
    libyaml-cpp-dev \
    liblapack-dev \
    libsuitesparse-dev \
    libcxsparse3 \
    libgflags-dev \
    libgoogle-glog-dev \
    tmux

# ROS Noetic
RUN install -d -m 0755 /etc/apt/keyrings && \
    wget ${WGET_RETRY_OPTS} \
        https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc \
        -O /etc/apt/keyrings/ros.asc && \
    wget ${WGET_RETRY_OPTS} \
        https://apt.llvm.org/llvm-snapshot.gpg.key \
        -O /etc/apt/keyrings/llvm.asc && \
    . /etc/os-release && \
    echo "deb [signed-by=/etc/apt/keyrings/ros.asc] http://mirrors.ustc.edu.cn/ros/ubuntu/ ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/ros-latest.list && \
    echo "deb [signed-by=/etc/apt/keyrings/llvm.asc] https://apt.llvm.org/${VERSION_CODENAME}/ llvm-toolchain-${VERSION_CODENAME}-16 main" > /etc/apt/sources.list.d/llvm-16.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        clangd-16 \
        clang-format-16 \
        ros-${ROS_VERSION}-ros-base \
        ros-${ROS_VERSION}-nav-msgs \
        ros-${ROS_VERSION}-sensor-msgs \
        ros-${ROS_VERSION}-cv-bridge \
        ros-${ROS_VERSION}-rviz \
        ros-${ROS_VERSION}-image-transport-plugins \
        ros-${ROS_VERSION}-pcl-ros \
        ros-${ROS_VERSION}-message-filters \
        ros-${ROS_VERSION}-dynamic-reconfigure \
        ros-${ROS_VERSION}-rqt-reconfigure \
        ros-${ROS_VERSION}-tf \
        ros-${ROS_VERSION}-catkin \
        python3-catkin-tools \
        ros-${ROS_VERSION}-roslint \
        ros-${ROS_VERSION}-ddynamic-reconfigure \
        ros-${ROS_VERSION}-vrpn \
        ros-${ROS_VERSION}-geometry-msgs \
        ros-${ROS_VERSION}-tf2-ros \
        ros-${ROS_VERSION}-roscpp \
        ros-${ROS_VERSION}-roslaunch \
        ros-${ROS_VERSION}-cmake-modules \
        ros-${ROS_VERSION}-eigen-conversions \
        ros-${ROS_VERSION}-visualization-msgs \
        ros-${ROS_VERSION}-vrpn-client-ros && \
    update-alternatives --install /usr/bin/clangd clangd /usr/bin/clangd-16 160 && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-16 160 && \
    update-alternatives --set clangd /usr/bin/clangd-16 && \
    update-alternatives --set clang-format /usr/bin/clang-format-16 && \
    echo "source /opt/ros/${ROS_VERSION}/setup.bash" >> /root/.bashrc

# Livox ROS Driver2 links this SDK from /usr/local/lib. The driver source is
# mounted with the project at runtime, while the SDK is part of the image.
RUN for attempt in 1 2 3 4 5; do \
        git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
            ${LIVOX_SDK2_REPOSITORY} /tmp/Livox-SDK2 && break; \
        rm -rf /tmp/Livox-SDK2; \
        sleep 5; \
    done && \
    test -d /tmp/Livox-SDK2/.git && \
    git -C /tmp/Livox-SDK2 checkout --detach ${LIVOX_SDK2_COMMIT} && \
    cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
        -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/Livox-SDK2/build --parallel ${USE_PROC} && \
    cmake --install /tmp/Livox-SDK2/build && \
    ldconfig && \
    rm -rf /tmp/Livox-SDK2

# FAST-LIVO2 requires the legacy, non-templated Sophus API. The two setter
# substitutions make that pinned revision compatible with Eigen on Ubuntu 20.04.
RUN for attempt in 1 2 3 4 5; do \
        git -c http.version=HTTP/1.1 clone --filter=blob:none --no-checkout \
            ${SOPHUS_REPOSITORY} /tmp/Sophus && break; \
        rm -rf /tmp/Sophus; \
        sleep 5; \
    done && \
    test -d /tmp/Sophus/.git && \
    git -C /tmp/Sophus checkout --detach ${SOPHUS_COMMIT} && \
    sed -i \
        -e 's/unit_complex_\.real() = 1\.;/unit_complex_.real(1.);/' \
        -e 's/unit_complex_\.imag() = 0\.;/unit_complex_.imag(0.);/' \
        /tmp/Sophus/sophus/so2.cpp && \
    cmake -S /tmp/Sophus -B /tmp/Sophus/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/Sophus/build --target Sophus --parallel ${USE_PROC} && \
    cmake --install /tmp/Sophus/build && \
    install -d /usr/local/lib/cmake/Sophus && \
    printf '%s\n' \
        'set(Sophus_INCLUDE_DIR "/usr/local/include;/usr/include/eigen3")' \
        'set(Sophus_INCLUDE_DIRS "/usr/local/include;/usr/include/eigen3")' \
        'set(Sophus_LIBRARIES "/usr/local/lib/libSophus.so")' \
        'set(Sophus_LIBRARY "/usr/local/lib/libSophus.so")' \
        'set(Sophus_LIBRARY_DIR "/usr/local/lib")' \
        'set(Sophus_LIBRARY_DIRS "/usr/local/lib")' \
        > /usr/local/lib/cmake/Sophus/SophusConfig.cmake && \
    ldconfig && \
    rm -rf /tmp/Sophus /root/.cmake/packages/Sophus

# Download third-party source dependencies used by later build stages
WORKDIR /tmp
RUN mkdir -p /tmp/boostdesc_extfiles && \
    for file in boostdesc_bgm.i boostdesc_bgm_bi.i boostdesc_bgm_hd.i \
                boostdesc_binboost_064.i boostdesc_binboost_128.i boostdesc_binboost_256.i \
                boostdesc_lbgm.i; do \
        wget ${WGET_RETRY_OPTS} \
            https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_boostdesc_20161012/${file} \
            -O /tmp/boostdesc_extfiles/${file}; \
    done && \
    for file in vgg_generated_48.i vgg_generated_64.i vgg_generated_80.i vgg_generated_120.i; do \
        wget ${WGET_RETRY_OPTS} \
            https://raw.githubusercontent.com/opencv/opencv_3rdparty/contrib_xfeatures2d_vgg_20160317/${file} \
            -O /tmp/boostdesc_extfiles/${file}; \
    done && \
    wget ${WGET_RETRY_OPTS} \
        https://github.com/ceres-solver/ceres-solver/archive/refs/tags/${CERES_VERSION}.zip \
        -O /tmp/ceres-solver.zip && \
    unzip -q /tmp/ceres-solver.zip -d /tmp && \
    rm /tmp/ceres-solver.zip && \
    wget ${WGET_RETRY_OPTS} \
        https://github.com/ros-perception/vision_opencv/archive/refs/tags/${VISION_OPENCV_VERSION}.zip \
        -O /tmp/vision_opencv.zip && \
    unzip -q /tmp/vision_opencv.zip -d /tmp && \
    mv /tmp/vision_opencv-${VISION_OPENCV_VERSION}/cv_bridge /tmp/cv_bridge${OPENCV_VERSION} && \
    rm -rf /tmp/vision_opencv-${VISION_OPENCV_VERSION} /tmp/vision_opencv.zip && \
    sed -i 's|^project(cv_bridge)$|project(cv_bridge_454)|' /tmp/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
    sed -i '/^set(_opencv_version 4)/i set(OpenCV_DIR /usr/local/opencv-4.5.4/lib/cmake/opencv4)' /tmp/cv_bridge${OPENCV_VERSION}/CMakeLists.txt && \
    sed -i 's|<name>cv_bridge</name>|<name>cv_bridge_454</name>|' /tmp/cv_bridge${OPENCV_VERSION}/package.xml

# Install OpenCV4 with CUDA
RUN for attempt in 1 2 3 4 5; do \
        git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib && break; \
        rm -rf /tmp/opencv_contrib; \
        sleep 5; \
    done && \
    test -d /tmp/opencv_contrib && \
    cp /tmp/boostdesc_extfiles/*.i /tmp/opencv_contrib/modules/xfeatures2d/src/
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgtk2.0-dev && \
    wget ${WGET_RETRY_OPTS} \
        https://github.com/opencv/opencv/archive/${OPENCV_VERSION}.zip \
        -O opencv.zip && \
    unzip opencv.zip && \
    rm opencv.zip && \
    OPENCV4_BUILD_LIST=calib3d,features2d,highgui,dnn,imgproc,imgcodecs && \
    OPENCV4_BUILD_LIST=${OPENCV4_BUILD_LIST},cudev,cudaoptflow,cudaimgproc,cudalegacy,cudaarithm && \
    OPENCV4_BUILD_LIST=${OPENCV4_BUILD_LIST},cudacodec,cudastereo,cudafeatures2d,xfeatures2d,tracking && \
    OPENCV4_BUILD_LIST=${OPENCV4_BUILD_LIST},stereo,aruco,videoio,ccalib && \
    cd opencv-${OPENCV_VERSION} && \
    mkdir build && cd build && \
    cmake \
        -DCMAKE_BUILD_TYPE=RELEASE \
        -DCMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV_VERSION} \
        -DWITH_CUDA=ON \
        -DWITH_CUDNN=ON \
        -DWITH_CUBLAS=ON \
        -DCUDNN_VERSION='8.9.6' \
        -DCUDNN_INCLUDE_DIR=/usr/include/ \
        -DCUDA_ARCH_BIN=${CUDA_ARCH_BIN} \
        -DCUDA_ARCH_PTX="" \
        -DCUDA_FAST_MATH=ON \
        -DWITH_TBB=ON \
        -DBUILD_opencv_python2=OFF \
        -DBUILD_opencv_python3=ON \
        -DOPENCV_DNN_CUDA=ON \
        -DOPENCV_ENABLE_NONFREE=ON \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_opencv_java=OFF \
        -DBUILD_opencv_python=OFF \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_opencv_apps=OFF \
        -DENABLE_NEON=${ENABLE_NEON} \
        -DEIGEN_INCLUDE_PATH=/usr/include/eigen3 \
        -DWITH_EIGEN=ON \
        -DWITH_IPP=OFF \
        -DWITH_OPENCL=OFF \
        -DPYTHON3_LIBRARY=/usr/lib/x86_64-linux-gnu/libpython3.8.so \
        -DBUILD_LIST=${OPENCV4_BUILD_LIST} \
        .. && \
    make -j${USE_PROC} && \
    make install && \
    rm -rf /tmp/opencv-${OPENCV_VERSION} /tmp/opencv_contrib /tmp/boostdesc_extfiles

# Build cv_bridge for OpenCV4.5.4
RUN mkdir -p /root/cv_bridge${OPENCV_VERSION}_ws/src && \
    mv /tmp/cv_bridge${OPENCV_VERSION} /root/cv_bridge${OPENCV_VERSION}_ws/src && \
    /bin/bash -c 'source /opt/ros/${ROS_VERSION}/setup.bash && \
        cd /root/cv_bridge${OPENCV_VERSION}_ws && \
        catkin_make && \
        echo "source /root/cv_bridge${OPENCV_VERSION}_ws/devel/setup.bash" >> /root/.bashrc'

# Install Intel RealSense SDK
WORKDIR /tmp
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    install -d -m 0755 /etc/apt/keyrings && \
    curl --fail --silent --show-error --location \
        --retry 5 \
        --retry-delay 5 \
        --connect-timeout 30 \
        "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xFB0B24895113F120" \
        -o /etc/apt/keyrings/librealsense.asc && \
    printf "%s\n" \
        "deb [signed-by=/etc/apt/keyrings/librealsense.asc] https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/librealsense.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        librealsense2-dev=2.55.1-0~realsense.12422 \
        librealsense2=2.55.1-0~realsense.12422 \
        librealsense2-utils=2.55.1-0~realsense.12422 \
        librealsense2-dbg=2.55.1-0~realsense.12422 \
        librealsense2-gl=2.55.1-0~realsense.12422 && \
    apt-mark hold \
        librealsense2 \
        librealsense2-dev \
        librealsense2-utils \
        librealsense2-dbg

# Install MAVROS
RUN apt-get install -y --no-install-recommends ros-${ROS_VERSION}-mavros && \
    cd /opt/ros/${ROS_VERSION}/lib/mavros && \
    for attempt in 1 2 3 4 5; do \
        ./install_geographiclib_datasets.sh && break; \
        sleep 5; \
    done && \
    test -d /usr/share/GeographicLib

# Build Ceres
RUN cd /tmp/ceres-solver-2.0.0rc1 && \
    mkdir build && cd build && \
    cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCUDA=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_BENCHMARKS=OFF \
        .. && \
    make -j${USE_PROC} && \
    make install && \
    rm -rf /tmp/ceres-solver-2.0.0rc1

# Install LCM
RUN for attempt in 1 2 3 4 5; do \
        git clone --depth 1 --branch v1.4.0 https://github.com/lcm-proj/lcm /tmp/lcm && break; \
        rm -rf /tmp/lcm; \
        sleep 5; \
    done && \
    test -d /tmp/lcm && \
    cd /tmp/lcm && \
    mkdir build && cd build && \
    cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_BENCHMARKS=OFF \
        .. && \
    make -j${USE_PROC} && \
    make install && \
    rm -rf /tmp/lcm

# Install onnxruntime
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip && \
    /usr/bin/pip3 install ${PIP_RETRY_OPTS} \
        onnxruntime \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

# Install dependencies for gscam
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gstreamer1.0-tools \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer-plugins-good1.0-dev \
        ros-${ROS_VERSION}-camera-calibration-parsers \
        ros-${ROS_VERSION}-camera-info-manager

# Build OpenCV3
RUN cd /tmp && \
    wget ${WGET_RETRY_OPTS} \
        https://github.com/opencv/opencv/archive/refs/tags/${OPENCV3_VERSION}.zip \
        -O opencv-${OPENCV3_VERSION}.zip && \
    wget ${WGET_RETRY_OPTS} \
        https://github.com/opencv/opencv_contrib/archive/refs/tags/${OPENCV3_VERSION}.zip \
        -O opencv_contrib-${OPENCV3_VERSION}.zip && \
    unzip -q opencv-${OPENCV3_VERSION}.zip && \
    unzip -q opencv_contrib-${OPENCV3_VERSION}.zip && \
    rm opencv-${OPENCV3_VERSION}.zip opencv_contrib-${OPENCV3_VERSION}.zip && \
    cd /tmp/opencv-${OPENCV3_VERSION} && \
    mkdir build && cd build && \
    cmake \
        -DCMAKE_BUILD_TYPE=RELEASE \
        -DCMAKE_INSTALL_PREFIX=/usr/local/opencv-${OPENCV3_VERSION} \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib-${OPENCV3_VERSION}/modules \
        -DWITH_CUDA=ON \
        -DCUDA_ARCH_BIN=${CUDA_ARCH_BIN} \
        -DCUDNN_VERSION='8.9.6' \
        -DCUDNN_INCLUDE_DIR=/usr/include/ \
        -DCUDA_ARCH_PTX="" \
        -DENABLE_FAST_MATH=ON \
        -DCUDA_FAST_MATH=ON \
        -DWITH_CUBLAS=ON \
        -DWITH_LIBV4L=ON \
        -DWITH_GSTREAMER=ON \
        -DWITH_GSTREAMER_0_10=OFF \
        -DWITH_QT=ON \
        -DWITH_OPENGL=ON \
        -DCUDA_NVCC_FLAGS="--expt-relaxed-constexpr" \
        -DWITH_TBB=ON \
        -DBUILD_opencv_python=OFF \
        -DBUILD_opencv_python2=OFF \
        -DBUILD_opencv_python3=OFF \
        -DBUILD_opencv_java=OFF \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        .. && \
    make -j${USE_PROC} && \
    make install && \
    rm -rf /tmp/opencv-${OPENCV3_VERSION} /tmp/opencv_contrib-${OPENCV3_VERSION}

# TensorRT
WORKDIR /tmp
COPY ./TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-11.8.tar.gz /tmp
RUN mkdir -p /usr/local/TensorRT-8.6.1.6 && \
    tar -xzf TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-11.8.tar.gz \
        -C /usr/local/TensorRT-8.6.1.6 \
        --strip-components=1 && \
    ln -sfn /usr/local/TensorRT-8.6.1.6 /usr/local/tensorrt && \
    ln -sfn /usr/local/TensorRT-8.6.1.6/include /usr/local/include/tensorrt && \
    echo 'export LD_LIBRARY_PATH=/usr/local/tensorrt/lib:$LD_LIBRARY_PATH' >> /root/.bashrc && \
    cp /usr/local/tensorrt/bin/trtexec /bin/trtexec && \
    rm -f /tmp/TensorRT-8.6.1.6.Linux.x86_64-gnu.cuda-11.8.tar.gz

# Python utilities
RUN /usr/bin/pip3 install ${PIP_RETRY_OPTS} scikit-image

# Configure SSH
RUN mkdir /var/run/sshd && \
    echo 'root:123456' | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
EXPOSE 22

# Clean up all temp files
RUN apt-get clean && \
    rm -rf /var/tmp/* /var/lib/apt/lists/* /var/cache/apt/* /tmp/*
ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=
WORKDIR /root
